{
  "name": "TypeScript",
  "scopeName": "source.ts",
  "patterns": [
    {
      "name": "comment.line.double-slash.ts",
      "match": "//.*$"
    },
    {
      "name": "comment.block.ts",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.ts",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ts",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.ts",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.ts",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.template.ts",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "keyword.control.ts",
      "match": "\\b(if|else|switch|case|default|for|while|do|break|continue|return|throw|try|catch|finally|yield|await)\\b"
    },
    {
      "name": "keyword.other.ts",
      "match": "\\b(const|let|var|function|class|interface|type|enum|extends|implements|new|this|super|import|export|from|as|default|static|async|declare|abstract|readonly|public|private|protected)\\b"
    },
    {
      "name": "support.type.primitive.ts",
      "match": "\\b(string|number|boolean|any|unknown|never|void|object|symbol|bigint)\\b"
    },
    {
      "name": "constant.language.ts",
      "match": "\\b(true|false|null|undefined)\\b"
    },
    {
      "name": "constant.numeric.ts",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  ]
}
