{
  "name": "Python",
  "scopeName": "source.python",
  "patterns": [
    {
      "name": "comment.line.number-sign.python",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.triple.double.python",
      "begin": "\"\"\"",
      "end": "\"\"\""
    },
    {
      "name": "string.quoted.triple.single.python",
      "begin": "'''",
      "end": "'''"
    },
    {
      "name": "string.quoted.double.python",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.python",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.python",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.python",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.python",
      "match": "\\b(if|elif|else|for|while|try|except|finally|with|as|return|yield|pass|break|continue|async|await|raise|match|case)\\b"
    },
    {
      "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.python" },
        "2": { "name": "entity.name.function.python" }
      }
    },
    {
      "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.python" },
        "2": { "name": "entity.name.type.class.python" }
      }
    },
    {
      "name": "keyword.other.python",
      "match": "\\b(lambda|import|from|global|nonlocal|assert|del)\\b"
    },
    {
      "name": "keyword.operator.logical.python",
      "match": "\\b(and|or|not|in|is)\\b"
    },
    {
      "name": "constant.language.python",
      "match": "\\b(True|False|None)\\b"
    },
    {
      "name": "support.function.builtin.python",
      "match": "\\b(print|len|range|enumerate|zip|map|filter|int|float|str|bool|list|dict|set|tuple|min|max|sum|abs|round|any|all|open|type|isinstance|id)\\b"
    },
    {
      "name": "constant.numeric.python",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  ]
}
